@page "/home"

@rendermode InteractiveServer
@using DCSWorld_Comunity.Components.Pages.assets

<link href="Pages/Home.razor.css" rel="stylesheet" />


<PageTitle>DCS World Community</PageTitle>

<div class="app-container">

    <!-- SIDEBAR -->
    <aside class="sidebar">

        <div class="logo">
            <div class="logo-icon">D</div>
            <div>
                <span>DCS</span>
                <small>WORLD COMMUNITY</small>
            </div>
        </div>

        <nav class="navigation">
            <a class="nav-item active" href="/home">
                <span>⌂</span>
                Feed
            </a>

            <a class="nav-item" href="#">
                <span>◈</span>
                Misiones
            </a>

            <a class="nav-item" href="#">
                <span>+</span>
                Crear petición
            </a>

            <a class="nav-item" href="#">
                <span>★</span>
                Mis proyectos
            </a>

            <a class="nav-item" href="#">
                <span>◉</span>
                Comunidad
            </a>
        </nav>

        <div class="sidebar-bottom">

            <div class="points-box">
                <span class="points-label">MIS PUNTOS</span>
                <strong>1,240 XP</strong>

                <div class="progress">
                    <div class="progress-fill"></div>
                </div>

                <small>760 XP para el siguiente nivel</small>
            </div>

            <a class="nav-item" href="/">
                <span>↪</span>
                Cerrar sesión
            </a>

        </div>

    </aside>


    <!-- MAIN -->
    <main class="main-content">

        <!-- TOPBAR -->
        <header class="topbar">

            <div class="search">
                <span>⌕</span>
                <input placeholder="Buscar misiones, usuarios o aeronaves..." />
            </div>

            <div class="user-area">

                <button class="notification">
                    ♢
                </button>

                <div class="user">
                    <div class="avatar">RB</div>

                    <div class="user-info">
                        <strong>Robby</strong>
                        <small>Contributor</small>
                    </div>

                    <span class="arrow">⌄</span>
                </div>

            </div>

        </header>


        <!-- CONTENT -->
        <div class="content">

            <!-- FEED -->
            <section class="feed">

                <div class="feed-header">

                    <div>
                        <h1>Feed</h1>
                        <p>Descubre qué está pasando en la comunidad.</p>
                    </div>

                    <button class="create-button">
                        + Nueva petición
                    </button>

                </div>


                <!-- FILTERS -->
                <div class="filters">

                    <button class="filter active">
                        Para ti
                    </button>

                    <button class="filter">
                        Más recientes
                    </button>

                    <button class="filter">
                        Más recompensados
                    </button>

                    <button class="filter">
                        Misiones
                    </button>

                </div>


                <!-- PETICIÓN 1 -->
                <Article
                    Author="JMAviation"
                    AuthorInitials="JM"
                    TimeAgo="hace 5 h"
                    Status="ABIERTA"
                    Title="Livery F-14 Tomcat — VF-84 Jolly Rogers"
                    Description="Se busca artista para crear una livery basada en el esquema histórico de VF-84. Se requiere alta fidelidad en insignias y numerales."
                    Tags="@(new List<string> { "F-14", "Livery", "Texturing" })"
                    Reward="350"
                    Proposals="4"
                    Likes="14"
                    Comments="7"
                 />


                <!-- PETICIÓN 2 -->
               

            </section>


            <!-- RIGHT PANEL -->
            <aside class="right-panel">

                <div class="panel">

                    <div class="panel-title">
                        <h3>Comunidad</h3>
                        <a href="#">Ver todo</a>
                    </div>


                    <div class="community-user">

                        <div class="avatar orange">
                            AC
                        </div>

                        <div>
                            <strong>AirCombatMX</strong>
                            <span>1,840 XP</span>
                        </div>

                    </div>


                    <div class="community-user">

                        <div class="avatar blue">
                            JM
                        </div>

                        <div>
                            <strong>JMAviation</strong>
                            <span>1,620 XP</span>
                        </div>

                    </div>


                    <div class="community-user">

                        <div class="avatar purple">
                            MX
                        </div>

                        <div>
                            <strong>MaverickMX</strong>
                            <span>1,420 XP</span>
                        </div>

                    </div>

                </div>


                <div class="panel">

                    <div class="panel-title">
                        <h3>Temas populares</h3>
                    </div>

                    <div class="topic">
                        <span># F/A-18C</span>
                        <small>128 publicaciones</small>
                    </div>

                    <div class="topic">
                        <span># Mission Editor</span>
                        <small>94 publicaciones</small>
                    </div>

                    <div class="topic">
                        <span># Liveries</span>
                        <small>76 publicaciones</small>
                    </div>

                    <div class="topic">
                        <span># Multiplayer</span>
                        <small>63 publicaciones</small>
                    </div>

                </div>

            </aside>

        </div>

    </main>

</div>

